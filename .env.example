# App
APP_NAME=kb-platform
APP_ENV=local
APP_PORT=8080
WEB_PORT=3000

# Database (local Docker or cloud — set POSTGRES_SSL=true for Aiven/Neon/Supabase)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kb_platform
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=          # REQUIRED: set before docker-compose up
POSTGRES_SSL=false          # Set true for cloud-hosted PostgreSQL

# Cache / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # REQUIRED: set before docker-compose up
QUEUE_NAMESPACE=kb

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_RAW=kb-raw
S3_BUCKET_DERIVED=kb-derived
MINIO_ROOT_USER=            # REQUIRED: MinIO admin username
MINIO_ROOT_PASSWORD=        # REQUIRED: MinIO admin password

# Security (REQUIRED — docker-compose will error without these)
JWT_SECRET=              # REQUIRED: min 32 chars (openssl rand -hex 32)
ENCRYPTION_KEY=          # REQUIRED: exactly 32 chars for AES-256

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-5.4

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
