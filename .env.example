# App
APP_NAME=kb-platform
APP_ENV=local
APP_PORT=8080
WEB_PORT=3000

# Database (local Docker or cloud — set POSTGRES_SSL=true for Aiven/Neon/Supabase)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kb_platform
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=          # REQUIRED: set before docker-compose up
POSTGRES_SSL=false          # Set true for cloud-hosted PostgreSQL

# Cache / Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=             # REQUIRED: set before docker-compose up
QUEUE_NAMESPACE=kb

# Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_RAW=kb-raw
S3_BUCKET_DERIVED=kb-derived
MINIO_ROOT_USER=            # REQUIRED: MinIO admin username
MINIO_ROOT_PASSWORD=        # REQUIRED: MinIO admin password

# Security (REQUIRED — docker-compose will error without these)
JWT_SECRET=              # REQUIRED: min 32 chars (openssl rand -hex 32)
ENCRYPTION_KEY=          # REQUIRED: exactly 32 chars for AES-256

# PA Pass (central auth)
PASS_BASE_URL=http://localhost:3001   # PA platform API base URL
KB_PRODUCT_ID=                         # REQUIRED: UUID from PA product management

# Model providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-5.4

# Bridge LLM (v0.53+) — Zhipu GLM is the LLM router for the KB bridge service
GLM_API_KEY=                     # Get from https://open.bigmodel.cn/usercenter/apikeys
BRIDGE_LLM_PROVIDER=glm
BRIDGE_LLM_MODEL=glm-4-flash
BRIDGE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
BRIDGE_LLM_STRICT=true           # Hard switch: refuse fallback to OpenAI/Anthropic

# Hogwarts-KB integration (v0.53+)
HOGWARTS_KB_PATH=                # Absolute path to local Hogwarts-KB clone
HOGWARTS_KB_REMOTE=              # e.g. https://github.com/USER/hogwarts-kb.git
HOGWARTS_KB_AUTO_PUSH=false      # Set true to auto-push wiki updates back to GitHub
HOGWARTS_KB_BRANCH=main          # Branch to sync against

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
