{
  "dashboard": {
    "title": "KB Platform Overview",
    "uid": "kb-platform-overview",
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "title": "API Request Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
        "targets": [{"expr": "rate(http_requests_total{service=\"api\"}[5m])", "legendFormat": "{{method}} {{path}}"}]
      },
      {
        "title": "API Error Rate",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
        "targets": [{"expr": "rate(http_requests_total{service=\"api\",status=~\"5..\"}[5m])", "legendFormat": "5xx errors"}]
      },
      {
        "title": "API P95 Latency",
        "type": "timeseries",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
        "targets": [{"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"api\"}[5m]))", "legendFormat": "P95"}]
      },
      {
        "title": "Worker Task Success Rate",
        "type": "gauge",
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
        "targets": [{"expr": "rate(celery_task_succeeded_total[5m]) / (rate(celery_task_succeeded_total[5m]) + rate(celery_task_failed_total[5m]))", "legendFormat": "success rate"}]
      },
      {
        "title": "Redis Memory Usage",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
        "targets": [{"expr": "redis_memory_used_bytes{service=\"redis\"}", "legendFormat": "used"}]
      },
      {
        "title": "PostgreSQL Active Connections",
        "type": "stat",
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
        "targets": [{"expr": "pg_stat_activity_count{service=\"postgres\"}", "legendFormat": "connections"}]
      }
    ]
  }
}
